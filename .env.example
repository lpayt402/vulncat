# Copy this file to .env before the first start.
# Required secrets are intentionally blank. Docker Compose refuses to start until both are set.
#
# PowerShell secret generator (run twice, once for each secret):
#   $b = New-Object byte[] 32; $r = [Security.Cryptography.RandomNumberGenerator]::Create()
#   $r.GetBytes($b); ($b | ForEach-Object { $_.ToString('x2') }) -join ''
#
# POSIX secret generator:
#   openssl rand -hex 32
#
# Use URL-safe hexadecimal for POSTGRES_PASSWORD because it is included in DATABASE_URL.
POSTGRES_DB=workbench
POSTGRES_USER=workbench
POSTGRES_PASSWORD=
SECRET_KEY=

# Default single-origin local deployment.
PUBLIC_URL=http://localhost:8787
VULNERABILITY_WORKBENCH_BIND_ADDRESS=127.0.0.1
VULNERABILITY_WORKBENCH_PORT=8787
ENVIRONMENT=production
LOG_LEVEL=INFO
SECURE_COOKIES=false
SESSION_TIMEOUT_MINUTES=480
SESSION_COOKIE_NAME=vulnerability_workbench_session

# Import, identity, finding, and export policy.
MAX_UPLOAD_BYTES=536870912
TRACKED_SEVERITIES=medium,low
IP_ASSOCIATION_STALENESS_DAYS=90
IDENTITY_AUTO_MATCH_THRESHOLD=0.85
MATURITY_GATE_DAYS=30
MEDIUM_SLA_DAYS=60
LOW_SLA_DAYS=90
ALLOW_FINDING_DATE_MATURITY_FALLBACK=false
LARGE_EXPORT_FINDING_THRESHOLD=10000

# Retention. Blank evidence values mean no automatic deletion.
EXPORT_RETENTION_DAYS=30
UPLOAD_RETENTION_DAYS=
IMPORT_EVIDENCE_RETENTION_DAYS=
AUDIT_RETENTION_DAYS=

# Worker and authentication controls.
WORKER_POLL_SECONDS=1.0
WORKER_LEASE_SECONDS=300
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15
DB_STARTUP_TIMEOUT_SECONDS=90
WEB_CONCURRENCY=2

# Trust proxy forwarding only when a known reverse proxy is deployed.
FORWARDED_ALLOW_IPS=127.0.0.1

# Host backup directory mounted only into the PostgreSQL container.
BACKUP_DIR=./backups

# Resource-limit examples. Increase worker/database memory for validated large imports and exports.
WEB_CPU_LIMIT=1.0
WEB_MEMORY_LIMIT=1G
WEB_PIDS_LIMIT=256
WORKER_CPU_LIMIT=2.0
WORKER_MEMORY_LIMIT=2G
WORKER_PIDS_LIMIT=256
DB_CPU_LIMIT=2.0
DB_MEMORY_LIMIT=2G
DB_PIDS_LIMIT=256
